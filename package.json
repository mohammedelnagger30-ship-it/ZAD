{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "check:data": "tsx --tsconfig tsconfig.app.json scripts/check-quran-data.ts",
    "check:pages": "tsx --tsconfig tsconfig.app.json scripts/check-page-map.ts",
    "check:flow": "tsx --tsconfig tsconfig.app.json scripts/check-mushaf-flow.ts",
    "check:icons": "powershell -ExecutionPolicy Bypass -File scripts/check-icons.ps1",
    "check:prayer-times": "tsx --tsconfig tsconfig.app.json scripts/check-prayer-timezones.ts",
    "check:prayer-reference": "tsx --tsconfig tsconfig.app.json scripts/check-prayer-time-reference.ts",
    "check:assets": "node scripts/check-web-assets.mjs dist",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:data && npm run check:text && npm run check:content && npm run check:word-split && npm run check:pages && npm run check:flow && npm run check:icons && npm run check:prayer-times && npm run check:prayer-reference -- scripts/data/esa-prayer-times-2026-10.json && npm run build && npm run check:assets",
    "data:fetch": "tsx scripts/fetch-content.ts",
    "data:tafsir": "tsx scripts/fetch-tafsir.ts",
    "data:catalog": "tsx scripts/build-content-catalog.ts",
    "data:huwaini": "tsx scripts/build-huwaini-catalog.ts",
    "data:mushaf-pages": "node scripts/fetch-tanzil-page-starts.mjs",
    "check:text": "tsx --tsconfig tsconfig.app.json scripts/check-quran-text.ts",
    "check:content": "tsx --tsconfig tsconfig.app.json scripts/check-content.ts",
    "check:word-split": "tsx --tsconfig tsconfig.app.json scripts/check-word-split.ts",
    "build:flow": "node scripts/measure-word-widths.mjs && tsx scripts/build-mushaf-flow.ts",
    "build:flow:only": "tsx scripts/build-mushaf-flow.ts",
    "build:word-meaning-index": "tsx --tsconfig tsconfig.app.json scripts/build-word-meaning-index.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@js-joda/core": "^6.3.0",
    "@js-joda/timezone": "^3.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "adhan": "^4.4.6",
    "dexie": "^4.4.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
