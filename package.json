{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "check:data": "tsx --tsconfig tsconfig.app.json scripts/check-quran-data.ts",
    "check:pages": "tsx --tsconfig tsconfig.app.json scripts/check-page-map.ts",
    "check:flow": "tsx --tsconfig tsconfig.app.json scripts/check-mushaf-flow.ts",
    "check:icons": "powershell -ExecutionPolicy Bypass -File scripts/check-icons.ps1",
    "check:prayer-times": "tsx --tsconfig tsconfig.app.json scripts/check-prayer-timezones.ts",
    "check:assets": "node scripts/check-web-assets.mjs dist",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:data && npm run check:text && npm run check:content && npm run check:pages && npm run check:flow && npm run check:icons && npm run check:prayer-times && npm run build && npm run check:assets",
    "data:fetch": "tsx scripts/fetch-content.ts",
    "data:tafsir": "tsx scripts/fetch-tafsir.ts",
    "data:catalog": "tsx scripts/build-content-catalog.ts",
    "check:text": "tsx --tsconfig tsconfig.app.json scripts/check-quran-text.ts",
    "check:content": "tsx --tsconfig tsconfig.app.json scripts/check-content.ts",
    "build:flow": "node scripts/measure-word-widths.mjs && tsx scripts/build-mushaf-flow.ts",
    "build:flow:only": "tsx scripts/build-mushaf-flow.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "adhan": "^4.4.6",
    "dexie": "^4.4.6",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.9.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
