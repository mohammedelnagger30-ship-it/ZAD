<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for the adhan notification (capacitor.config.ts: smallIcon).

  The system masks this to a single alpha shape and tints it with the channel colour, so
  it is pure white. Without it Capacitor falls back to android.R.drawable.ic_dialog_info
  and every adhan alert shows a generic gear.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Mosque silhouette: base, arched doorway (evenodd hole), dome, spire, minarets. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,6.2 L13,9.6 H11 Z
            M7.5,14 a4.5,4.5 0 0 1 9,0 Z
            M5,14 H19 V21 H5 Z
            M10.5,21 V17.6 a1.5,1.5 0 0 1 3,0 V21 Z
            M3,8 H4.5 V21 H3 Z
            M2.75,8 a1,1 0 0 1 2,0 Z
            M19.5,8 H21 V21 H19.5 Z
            M19.25,8 a1,1 0 0 1 2,0 Z" />
</vector>
