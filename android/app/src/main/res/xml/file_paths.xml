<?xml version="1.0" encoding="utf-8"?>
<!-- Only the two paths the app actually serves through the FileProvider are kept:
     the update APK (AppUpdater downloads into cache/) and downloaded adhan voices
     (Capacitor Directory.DATA + adhan_store/), which a prayer channel rings. No
     shared-storage entries: nothing in the app writes there anymore. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="my_cache_images" path="." />
    <files-path name="adhans" path="adhan_store/" />
</paths>
