{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* The path alias — the scripts import from `src/` the same way the app
       does, and are run with `tsx --tsconfig tsconfig.app.json`. `vite/client`
       is here because they reach `hadithService`, which reads `import.meta.env`. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["vite.config.ts", "scripts/**/*.ts"],
  "exclude": ["scripts/__tests__"]
}
